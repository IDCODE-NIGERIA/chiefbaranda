# Copy to .env and fill in. Never commit the filled-in file (.gitignore covers .env*).
# Next.js and the Prisma CLI both read .env.

# ---- Database (Postgres, via Prisma) ----
# Use sslmode=verify-full, not sslmode=require. `require` only encrypts the
# connection without checking the server's certificate under libpq semantics,
# which the pg driver is moving to — verify-full also verifies the certificate,
# so nobody can sit in the middle of your database traffic.
#
# Pooled connection — used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/db?sslmode=verify-full"
# Direct (unpooled) connection — used for migrations, which a pooler can't run.
# On Neon this is the same host with "-pooler" removed.
DIRECT_URL="postgresql://user:password@host/db?sslmode=verify-full"

# ---- Auth ----
# Long random string. Generate with: openssl rand -base64 48
# Required in production — the app refuses to start without it.
JWT_SECRET=""

# ---- Site ----
# Absolute URL, used to build the Paystack callback. No trailing slash.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ---- Admin access ----
# Comma separated emails allowed into /admin.
ADMIN_EMAILS=""

# ---- Payments (Paystack) ----
# Dashboard -> Settings -> API Keys & Webhooks. Use sk_test_/pk_test_ while developing.
# Without these, orders are still recorded but no payment is taken.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
# Set the webhook URL in the Paystack dashboard to:
#   https://your-domain.com/api/payments/webhook

# ---- Admin alerts (Termii SMS) ----
# https://accounts.termii.com -> API key
# Without a key, alerts are logged to the console instead of sent.
TERMII_API_KEY=""
# Approved sender ID. "N-Alert" works for transactional messages without approval.
TERMII_SENDER_ID="N-Alert"
# Comma separated. Nigerian format, e.g. 08031234567,08109876543
ADMIN_PHONES=""
